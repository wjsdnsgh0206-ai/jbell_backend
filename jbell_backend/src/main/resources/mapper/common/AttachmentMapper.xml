<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jbell.common.mapper.AttachmentMapper">

    <insert id="insertAttachment" useGeneratedKeys="true" keyProperty="fileId" parameterType="jbell.common.domain.AttachmentVO">
        INSERT INTO attachment (
             file_ext
            ,file_path
            ,file_name
            ,file_real_name
            ,file_size
            ,content_id
            ,file_type
            ,created_at
        ) VALUES (
             #{fileExt}
            ,#{filePath}
            ,#{fileName}
            ,#{fileRealName}
            ,#{fileSize}
            ,NULL  ,#{fileType}
            ,NOW()
        )
    </insert>

    <update id="updateContentId">
        UPDATE attachment
        SET content_id = #{contentId}
        WHERE file_id IN
        <foreach item="id" collection="fileIds" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
    
    <select id="selectListByContentId" resultType="jbell.common.domain.AttachmentVO">
        SELECT * FROM attachment WHERE content_id = #{contentId}
    </select>

</mapper>